# Files with unusual names (trailing space, no extension) that are likely mistakes.
#
# ⚠️ THESE ARE SUBSTRING GLOBS, AND EVERY ONE OF THEM NEEDS A NEGATION.
# `**/*references*` matches "Preferences", so it swallowed
# lib/Controller/PreferencesController.php — and, worse, ANY DIRECTORY whose
# name contains the substring: `openspec/specs/user-preferences/` resolved
# locally, was absent from the commit, and CI then reported the `@spec` tag as
# a missing file while the author was looking straight at the file on disk.
# A test file (tests/…/PreferencesControllerTest.php) hit the same trap.
#
# Each junk pattern is therefore paired with negations that re-admit real
# source files and real directories. Naming ONE file (the old
# `!**/PreferencesController.php`) fixes one symptom and leaves the class of
# bug live. openregister's .gitignore is the reference implementation.
**/PR *
**/adds *
**/implements *
**/ALL *
**/endpoints *
**/*Analysis*
!**/*Analysis*.php
!**/*Analysis*/
**/*references*
!**/*references*.php
!**/*references*.vue
!**/*references*.js
!**/*references*.ts
!**/*references*.json
!**/*references*.md
!**/*references*/
**/*encoding*
!**/*encoding*.php
!**/*encoding*/
**/ter
**/clearCache*
!**/clearCache*.php
!**/clearCache*/
**/update*Settings*
!**/update*Settings*.php
!**/update*Settings*.vue
!**/update*Settings*/
**/rebase*
!**/rebase*.php
!**/rebase*/
**/setup*
!**/setup*.php
!**/setup*.js
!**/setup*.ts
!**/setup*/

# Temporary test files that shouldn't be committed
simple-solr-test.php
test-solr-connection.php

phpqa/

# Docker AI models (too large for git)
docker/dolphin/models/

# Issues folder should be tracked
!issues/
!issues/**

/docusaurus/node_modules/
/docusaurus/build/
/docusaurus/.docusaurus/

# Docusaurus documentation site (docs/) — build artefacts only; sources are tracked
/docs/node_modules/
/docs/build/
/docs/.docusaurus/
/docs/.cache-loader/
/docs/i18n/nl/

# Playwright (tests/e2e/) — reports, traces, and captured outputs are not committed
/tests/e2e/playwright-report/
/tests/e2e/test-results/
/test-results/
/playwright-report/

# Test screenshots — images generated by browser test commands (test-app, run-test-scenario)
# Only images are ignored; markdown reports and scenario files are kept in git.
test-results/**/*.png
test-results/**/*.jpg
test-results/**/*.jpeg
test-results/**/*.gif
test-results/**/*.webp
openspec/test-site-results/**/*.png
openspec/test-site-results/**/*.jpg
openspec/test-site-results/**/*.jpeg
openspec/test-site-results/**/*.gif
openspec/test-site-results/**/*.webp

# SBOM is published as release asset (see SECURITY.md), not stored in repo
sbom.cdx.json
bom-php.cdx.json
bom-npm.cdx.json
