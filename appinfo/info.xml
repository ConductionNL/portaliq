<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>portaliq</id>
    <name lang="en">Portaliq</name>
    <name lang="nl">Portaliq</name>
    <summary lang="en">One shared external portal for clients and suppliers.</summary>
    <summary lang="nl">Eén gedeeld extern portaal voor klanten en leveranciers.</summary>
    <description lang="en"><![CDATA[Portaliq is the fleet's shared external portal. Clients (citizens) and suppliers (companies) get one integrated, white-label portal to see and act on their records across every app — reading data through OpenRegister and rendering each app's registered portal contribution. It owns the external auth edge (DigiD / eHerkenning / eIDAS), the white-label portal shell, the unified inbox, and the portal-contribution registry. Employees stay internal. See ADR-046.]]></description>
    <description lang="nl"><![CDATA[Portaliq is het gedeelde externe portaal voor de hele appsuite. Klanten (burgers) en leveranciers (bedrijven) krijgen één geïntegreerd, white-label portaal om hun gegevens over alle apps heen in te zien en er acties op te doen — gegevens komen via OpenRegister en elke app levert zijn eigen portaalbijdrage. Portaliq verzorgt de externe authenticatie (DigiD / eHerkenning / eIDAS), de white-label portaalschil, de gebundelde berichtenbox en het register van portaalbijdragen. Medewerkers blijven intern. Zie ADR-046.]]></description>
    <version>0.1.8</version>
    <licence>EUPL-1.2</licence>
    <author mail="info@conduction.nl" homepage="https://www.conduction.nl/">Conduction</author>
    <namespace>Portaliq</namespace>
    <documentation>
        <user>https://codeberg.org/Conduction/portaliq</user>
        <admin>https://codeberg.org/Conduction/portaliq</admin>
        <developer>https://codeberg.org/Conduction/portaliq</developer>
    </documentation>
    <category>tools</category>
    <website>https://codeberg.org/Conduction/portaliq</website>
    <discussion>https://codeberg.org/Conduction/portaliq/discussions</discussion>
    <bugs>https://codeberg.org/Conduction/portaliq/issues</bugs>
    <repository>https://codeberg.org/Conduction/portaliq</repository>

    <screenshot>https://codeberg.org/Conduction/portaliq/raw/branch/main/img/app-store.svg</screenshot>

    <dependencies>
        <!--
        App dependency (not expressible in app-info.xsd): OpenRegister — every
        Portaliq entity is an OpenRegister object, and src/manifest.json lists
        "openregister" as a required dependency.

        min-version is therefore 32, NOT 28: openregister declares min-version="32"
        because its lib/ContextChat/ContentProvider.php implements
        OCP\ContextChat\IContentProvider, an interface core does not have before
        Nextcloud 32. On NC 28-31 openregister refuses to install ("cannot be
        installed because it is not compatible with this version of the server"), so
        the app cannot function there. Declaring 28 advertised a range this app
        cannot deliver. Same defect as openconnector#1173.
        -->
        <nextcloud min-version="28" max-version="34"/>
        <php min-version="8.3"/>
    </dependencies>

    <navigations>
        <navigation>
            <id>portaliq</id>
            <name>Portaliq</name>
            <route>portaliq.dashboard.page</route>
            <icon>app.svg</icon>
        </navigation>
    </navigations>

    <!-- @spec openspec/architecture/adr-023-action-authorization.md -->
    <repair-steps>
        <install>
            <step>OCA\Portaliq\Repair\InitializeSettings</step>
            <step>OCA\Portaliq\Repair\InitializeActions</step>
        </install>
        <post-migration>
            <step>OCA\Portaliq\Repair\InitializeSettings</step>
            <step>OCA\Portaliq\Repair\InitializeActions</step>
        </post-migration>
    </repair-steps>

    <settings>
        <admin>OCA\Portaliq\Settings\AdminSettings</admin>
        <admin-section>OCA\Portaliq\Sections\SettingsSection</admin-section>
    </settings>
</info>
