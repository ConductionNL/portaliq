    "full block": {
        "enabled": true,
        "kind": "site",
        "events": [
            "page_view",
            "search",
            "form_start",
            "search",
            "heat_click",
            "heat_scroll"
        ],
        "dimensions": [
            "pageReferrer",
            "searchTerm",
            "region",
            "deviceType",
            "userRef"
        ],
        "sessionTimeoutMinutes": 45,
        "retentionDays": 30,
        "consentRequired": true,
        "excludedPaths": [
            "/melden",
            "/priv\u00e9"
        ],
        "preConsentEvents": [
            "page_view",
            "search"
        ],
        "regionGranularity": "region",
        "persistClientId": true,
        "sensitive": {
            "persistClientId": true,
            "accountLinking": true,
            "heatmaps": true,
            "sessionRecording": false
        },
        "goals": [
            {
                "id": "contact",
                "name": "contact",
                "type": "page_reached",
                "match": {
                    "pathEquals": "/contact"
                },
                "value": 2.5
            }
        ],
        "funnels": [
            {
                "id": "f",
                "name": "F",
                "steps": [
                    {
                        "name": "a",
                        "match": {
                            "pathPrefix": "/a"
                        }
                    }
                ]
            }
        ],
        "customDimensions": [
            {
                "id": "audience",
                "name": "Audience",
                "scope": "session"
            }
        ],
        "segments": [
            {
                "id": "converted",
                "name": "Converted",
                "conditions": [
                    {
                        "dimension": "goal:contact",
                        "operator": "is",
                        "value": "true"
                    }
                ]
            },
            {
                "id": "mobile",
                "name": "Mobile",
                "conditions": [
                    {
                        "dimension": "deviceType",
                        "operator": "is",
                        "value": "mobile"
                    }
                ]
            }
        ],
        "rollupOf": [
            "noord"
        ],
        "reports": [
            {
                "id": "d",
                "name": "Daily",
                "cadence": "daily",
                "recipients": [
                    "admin"
                ],
                "sections": [
                    "overview"
                ]
            }
        ],
        "alerts": [
            {
                "id": "busy",
                "name": "Busy",
                "metric": "pageViews",
                "comparison": "above",
                "threshold": 50,
                "period": "day",
                "recipients": [
                    "admin"
                ]
            },
            {
                "id": "goal",
                "name": "goal",
                "metric": "goal:contact",
                "comparison": "below",
                "threshold": 1,
                "period": "day",
                "recipients": [
                    "admin"
                ]
            }
        ],
        "experiments": [
            {
                "id": "hero",
                "name": "hero",
                "status": "running",
                "page": "/",
                "variants": [
                    {
                        "id": "a",
                        "name": "a",
                        "weight": 1,
                        "changes": []
                    },
                    {
                        "id": "b",
                        "name": "b",
                        "weight": 1,
                        "pageRoute": "/b"
                    }
                ],
                "goal": "contact",
                "startedAt": "",
                "stoppedAt": ""
            }
        ]
    },
