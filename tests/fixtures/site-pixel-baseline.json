{
	"banner: a school warning": "<div class=\"nl-banner nl-banner--warning\" role=\"alert\" aria-live=\"assertive\" data-testid=\"nl-banner\"><p class=\"utrecht-paragraph nl-banner__text\">Vrijdag is de school dicht.</p><button type=\"button\" class=\"utrecht-button utrecht-button--subtle-action\" data-testid=\"nl-banner-close\">Sluiten</button></div>",
