	"link list: a school aside": "<nav class=\"utrecht-link-list-nav\" aria-labelledby=\"nl-link-list-1\" data-testid=\"nl-link-list\"><h2 id=\"nl-link-list-1\" class=\"utrecht-heading-3\">Meer</h2><ul class=\"utrecht-link-list\"><li class=\"utrecht-link-list__item\"><a class=\"utrecht-link utrecht-link-list__link\" href=\"/rooster\">Rooster</a><span class=\"utrecht-link-list__description\">Per klas</span></li><li class=\"utrecht-link-list__item\"><a class=\"utrecht-link utrecht-link-list__link\" href=\"https://example.org\">Ouderportaal</a></li></ul></nav>",
