{
	"about": "Local-mode visibleWhen cases, built from @conduction/nextcloud-vue tests/utils/visibleWhen.spec.js (v2.57.3, the version portaliq installs). tests/visible-when-local.spec.mjs runs every case against nextcloud-vue's evaluateVisibleWhenLocal, and tests/Unit/Service/Intake/VisibleWhenLocalTest.php runs the same cases against lib/Service/Intake/VisibleWhenLocal.php, so the two evaluators of one grammar cannot drift apart unnoticed (intake-conditional-questions-and-drafts D2). The reader is nobody: a public form has no Nextcloud account, so @me resolves to an empty string, and no app answers appInstalled.",
	"cases": [
		{ "name": "a null condition is always visible", "condition": null, "data": { "kind": "person" }, "visible": true },
		{ "name": "a string is not a condition", "condition": "nope", "data": {}, "visible": false },
		{ "name": "a number is not a condition", "condition": 42, "data": {}, "visible": false },
		{ "name": "a list is not a condition", "condition": [], "data": {}, "visible": false },
		{ "name": "a condition without a field hides", "condition": { "op": "eq", "value": 1 }, "data": {}, "visible": false },
		{ "name": "a condition with an empty field hides", "condition": { "field": "", "op": "eq", "value": 1 }, "data": {}, "visible": false },
		{ "name": "an endpoint condition is not local and hides", "condition": { "endpoint": "/x", "field": "a", "op": "eq", "value": 1 }, "data": { "a": 1 }, "visible": false },
		{ "name": "a source condition is not local and hides", "condition": { "source": { "register": "r", "schema": "s" }, "field": "a", "op": "eq", "value": 1 }, "data": { "a": 1 }, "visible": false },
		{ "name": "a dot-path reads into a nested answer", "condition": { "field": "address.country", "op": "eq", "value": "NL" }, "data": { "address": { "country": "NL" } }, "visible": true },
		{ "name": "a dot-path that does not match hides", "condition": { "field": "address.country", "op": "eq", "value": "NL" }, "data": { "address": { "country": "BE" } }, "visible": false },
		{ "name": "a dot-path through a missing answer hides", "condition": { "field": "address.country", "op": "eq", "value": "NL" }, "data": {}, "visible": false },
		{ "name": "eq holds on the same text", "condition": { "field": "kind", "op": "eq", "value": "company" }, "data": { "kind": "company" }, "visible": true },
		{ "name": "eq fails on other text", "condition": { "field": "kind", "op": "eq", "value": "company" }, "data": { "kind": "person" }, "visible": false },
		{ "name": "neq holds on other text", "condition": { "field": "kind", "op": "neq", "value": "company" }, "data": { "kind": "person" }, "visible": true },
		{ "name": "neq fails on the same text", "condition": { "field": "kind", "op": "neq", "value": "a" }, "data": { "kind": "a" }, "visible": false },
		{ "name": "gt", "condition": { "field": "kind", "op": "gt", "value": 5 }, "data": { "kind": 10 }, "visible": true },
		{ "name": "gt is strict", "condition": { "field": "kind", "op": "gt", "value": 5 }, "data": { "kind": 5 }, "visible": false },
		{ "name": "gte", "condition": { "field": "kind", "op": "gte", "value": 5 }, "data": { "kind": 5 }, "visible": true },
		{ "name": "lt", "condition": { "field": "kind", "op": "lt", "value": 5 }, "data": { "kind": 3 }, "visible": true },
		{ "name": "lte", "condition": { "field": "kind", "op": "lte", "value": 5 }, "data": { "kind": 5 }, "visible": true },
		{ "name": "an omitted op is eq", "condition": { "field": "kind", "value": "company" }, "data": { "kind": "company" }, "visible": true },
		{ "name": "an unknown op is eq", "condition": { "field": "kind", "op": "nope", "value": 1 }, "data": { "kind": 1 }, "visible": true },
		{ "name": "eq compares a number and its text alike", "condition": { "field": "kind", "op": "eq", "value": 3 }, "data": { "kind": "3" }, "visible": true },
		{ "name": "eq compares a whole float and an integer alike", "condition": { "field": "kind", "op": "eq", "value": 3 }, "data": { "kind": 3.0 }, "visible": true },
		{ "name": "eq compares true and its text alike", "condition": { "field": "kind", "op": "eq", "value": true }, "data": { "kind": "true" }, "visible": true },
		{ "name": "neq tells true from false", "condition": { "field": "kind", "op": "neq", "value": false }, "data": { "kind": true }, "visible": true },
		{ "name": "a hidden, so missing, answer never equals a text (cascade)", "condition": { "field": "kind", "op": "eq", "value": "y" }, "data": {}, "visible": false },
		{ "name": "ordering on text that is no number hides", "condition": { "field": "kind", "op": "gt", "value": 3 }, "data": { "kind": "x" }, "visible": false },
		{ "name": "ordering on a missing answer hides", "condition": { "field": "kind", "op": "gte", "value": 0 }, "data": {}, "visible": false },
		{ "name": "ordering reads an empty answer as zero", "condition": { "field": "kind", "op": "lte", "value": 0 }, "data": { "kind": "" }, "visible": true },
		{ "name": "ordering reads a null answer as zero", "condition": { "field": "kind", "op": "gte", "value": 0 }, "data": { "kind": null }, "visible": true },
		{ "name": "ordering trims a number written with spaces", "condition": { "field": "kind", "op": "gt", "value": 4 }, "data": { "kind": " 5 " }, "visible": true },
		{ "name": "ordering reads true as one", "condition": { "field": "kind", "op": "gte", "value": 1 }, "data": { "kind": true }, "visible": true },
		{ "name": "ordering reads a decimal", "condition": { "field": "kind", "op": "lt", "value": 2 }, "data": { "kind": "1.5" }, "visible": true },
		{ "name": "a missing answer is empty", "condition": { "field": "kind", "op": "empty" }, "data": {}, "visible": true },
		{ "name": "a null answer is empty", "condition": { "field": "kind", "op": "empty" }, "data": { "kind": null }, "visible": true },
		{ "name": "an empty text is empty", "condition": { "field": "kind", "op": "empty" }, "data": { "kind": "" }, "visible": true },
		{ "name": "an empty list is empty", "condition": { "field": "kind", "op": "empty" }, "data": { "kind": [] }, "visible": true },
		{ "name": "a missing answer is not notEmpty", "condition": { "field": "kind", "op": "notEmpty" }, "data": {}, "visible": false },
		{ "name": "text is notEmpty", "condition": { "field": "kind", "op": "notEmpty" }, "data": { "kind": "alice" }, "visible": true },
		{ "name": "zero is notEmpty", "condition": { "field": "kind", "op": "notEmpty" }, "data": { "kind": 0 }, "visible": true },
		{ "name": "false is notEmpty", "condition": { "field": "kind", "op": "notEmpty" }, "data": { "kind": false }, "visible": true },
		{ "name": "a list with an entry is notEmpty", "condition": { "field": "kind", "op": "notEmpty" }, "data": { "kind": ["a"] }, "visible": true },
		{ "name": "zero is not empty", "condition": { "field": "kind", "op": "empty" }, "data": { "kind": 0 }, "visible": false },
		{ "name": "all holds when every part holds", "condition": { "all": [{ "field": "isFinalStatus", "op": "neq", "value": true }, { "field": "assignee", "op": "empty" }] }, "data": { "isFinalStatus": false, "assignee": "" }, "visible": true },
		{ "name": "all fails when one part fails", "condition": { "all": [{ "field": "isFinalStatus", "op": "neq", "value": true }, { "field": "assignee", "op": "notEmpty" }] }, "data": { "isFinalStatus": false, "assignee": "" }, "visible": false },
		{ "name": "any holds when one part holds", "condition": { "any": [{ "field": "isFinalStatus", "op": "neq", "value": true }, { "field": "assignee", "op": "notEmpty" }] }, "data": { "isFinalStatus": false, "assignee": "" }, "visible": true },
		{ "name": "any fails when no part holds", "condition": { "any": [{ "field": "assignee", "op": "notEmpty" }] }, "data": { "isFinalStatus": false, "assignee": "" }, "visible": false },
		{ "name": "all of nothing holds", "condition": { "all": [] }, "data": {}, "visible": true },
		{ "name": "any of nothing fails", "condition": { "any": [] }, "data": {}, "visible": false },
		{ "name": "all nests", "condition": { "all": [{ "any": [{ "field": "a", "value": 1 }, { "field": "b", "value": 1 }] }, { "field": "c", "op": "notEmpty" }] }, "data": { "b": 1, "c": "x" }, "visible": true },
		{ "name": "an all that is no list falls through to any", "condition": { "all": { "nope": true }, "any": [{ "field": "a", "value": 1 }] }, "data": { "a": 1 }, "visible": true },
		{ "name": "a part that is no condition hides inside all", "condition": { "all": ["nope"] }, "data": {}, "visible": false },
		{ "name": "@me is nobody on a public form, so it equals an empty answer", "condition": { "field": "assignee", "op": "eq", "value": "@me" }, "data": { "assignee": "" }, "visible": true },
		{ "name": "@me is nobody on a public form, so it never equals a name", "condition": { "field": "assignee", "op": "eq", "value": "@me" }, "data": { "assignee": "admin" }, "visible": false },
		{ "name": "@me does not equal a null answer", "condition": { "field": "assignee", "op": "eq", "value": "@me" }, "data": { "assignee": null }, "visible": false },
		{ "name": "@object.<field> compares one answer with another", "condition": { "field": "end", "op": "gte", "value": "@object.start" }, "data": { "start": 3, "end": 5 }, "visible": true },
		{ "name": "@object.<field> compares one answer with another, and fails", "condition": { "field": "end", "op": "gte", "value": "@object.start" }, "data": { "start": 7, "end": 5 }, "visible": false },
		{ "name": "an unanswered @object.<field> stays the literal token", "condition": { "field": "a", "op": "eq", "value": "@object.zzz" }, "data": { "a": "@object.zzz" }, "visible": true },
		{ "name": "a token nothing resolves stays literal", "condition": { "field": "a", "op": "eq", "value": "@workspace.team" }, "data": { "a": "@workspace.team" }, "visible": true },
		{ "name": "text that only starts like a token is literal", "condition": { "field": "a", "op": "eq", "value": "me@example.nl" }, "data": { "a": "me@example.nl" }, "visible": true },
		{ "name": "an app nobody installed hides", "condition": { "appInstalled": "nosuchapp" }, "data": {}, "visible": false },
		{ "name": "an app nobody installed hides a field condition that would pass", "condition": { "appInstalled": "nosuchapp", "field": "a", "value": 1 }, "data": { "a": 1 }, "visible": false },
		{ "name": "the partner question shows when the resident lives together", "condition": { "field": "together", "op": "eq", "value": "Yes" }, "data": { "together": "Yes" }, "visible": true },
		{ "name": "the partner question hides when the resident does not", "condition": { "field": "together", "op": "eq", "value": "Yes" }, "data": { "together": "No" }, "visible": false }
	]
}
