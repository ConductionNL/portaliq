            "gridY": 0,
            "gridWidth": 4,
            "gridHeight": 1
          },
          {
            "id": 2,
            "widgetId": "active-sessions",
            "gridX": 4,
            "gridY": 0,
            "gridWidth": 4,
            "gridHeight": 1
          },
          {
            "id": 3,
            "widgetId": "unread-messages",
            "gridX": 8,
            "gridY": 0,
            "gridWidth": 4,
            "gridHeight": 1
          }
        ]
      }
    },
