          },
          {
            "id": "active-sessions",
            "title": "Active sessions",
            "type": "stats-block",
            "iconClass": "icon-category-security",
            "dataSource": {
              "register": "portaliq",
              "schema": "portalSession",
              "filter": {
                "revoked": false
              },
              "aggregate": "count"
            },
            "props": {
              "countLabel": "sessions",
              "variant": "success"
            }
          },
          {
            "id": "unread-messages",
