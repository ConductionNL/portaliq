    {
      "id": "Dashboard",
      "route": "/",
      "type": "dashboard",
      "title": "Dashboard",
      "config": {
        "widgets": [
          {
            "id": "active-accounts",
            "title": "Active accounts",
            "type": "stats-block",
            "iconClass": "icon-user",
            "dataSource": {
              "register": "portaliq",
              "schema": "portalAccount",
              "filter": {
                "status": "active"
