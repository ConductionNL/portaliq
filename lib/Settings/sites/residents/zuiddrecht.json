			"jsonFields": ["statusHistory"],
			"data": {
				"title": "Subsidie buurtfeest Lindelaan",
				"description": "Wij vragen een bijdrage voor het jaarlijkse buurtfeest in de Lindelaan.",
				"caseType": "{{lookup:caseType}}",
				"status": "{{lookup:status}}",
				"portalSubject": "{{subject}}",
				"intakeChannel": "website",
				"startDate": "{{date:-120}}",
				"endDate": "{{date:-88}}",
				"receivedAt": "{{datetime:-120 10:30}}",
				"currentStatusEnteredAt": "{{datetime:-88 13:15}}",
				"statusHistory": [
					{ "status": "{{lookup:ontvangen}}", "enteredAt": "{{datetime:-120 10:30}}" },
					{ "status": "{{lookup:beoordeling}}", "enteredAt": "{{datetime:-116 09:00}}" },
					{ "status": "{{lookup:besluit}}", "enteredAt": "{{datetime:-95 14:00}}" },
					{ "status": "{{lookup:status}}", "enteredAt": "{{datetime:-88 13:15}}" }
