				"ontvangen": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "Ontvangen" } },
				"bezig": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "In behandeling" } },
				"status": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "Afgehandeld" } }
			},
			"jsonFields": ["statusHistory"],
			"data": {
