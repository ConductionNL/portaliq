{
	"id": "zuiddrecht",
	"$comment": "The example resident of the Zuiddrecht example site: Sanne de Vries, five cases, one question and four messages. Installed by `occ portaliq:example-resident:install zuiddrecht`. Every date is a number of days from the day of the install, so the cases stay believable however long this file sits in the repo. Values in double braces are filled in at install time: {{subject}} is the resident's reference, {{lookup:name}} the id found by a lookup of the same object, {{object:key.field}} a field of an object written earlier in this file, {{date:n}} and {{datetime:n HH:MM}} a day n days from the install. `waitingOnApplicant` is written beside the open question on purpose: dossiq sets that flag in the act that sends a question, and a seed is not that act.",
	"portal": "zuiddrecht",
	"timezone": "Europe/Amsterdam",
	"resident": {
		"userId": "sanne.devries",
		"displayName": "Sanne de Vries",
		"audience": "citizen",
		"organisation": "zuiddrecht"
	},
	"signIn": {
		"mode": "nextcloud",
		"label": {
			"title": "Voorbeeldinwoner",
			"text": "Alleen op deze demo. U logt in als Sanne de Vries.",
			"button": "Inloggen als voorbeeldinwoner"
		}
	},
	"objects": [
		{
			"key": "woo-fietspad",
			"register": "dossiq",
			"schema": "case",
			"lookups": {
				"caseType": { "schema": "caseType", "where": { "identifier": "woo-verzoek" } },
				"ontvangen": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "Ontvangst" } },
				"status": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "Beoordeling ontvankelijkheid" } }
			},
			"jsonFields": ["statusHistory"],
			"data": {
				"title": "Verlichting fietspad Lindelaan",
				"description": "Ik wil de documenten over de nieuwe verlichting langs het fietspad aan de Lindelaan.",
				"caseType": "{{lookup:caseType}}",
				"status": "{{lookup:status}}",
				"portalSubject": "{{subject}}",
				"intakeChannel": "website",
				"startDate": "{{date:-2}}",
				"receivedAt": "{{datetime:-2 09:12}}",
				"currentStatusEnteredAt": "{{datetime:-1 10:05}}",
				"statusHistory": [
					{ "status": "{{lookup:ontvangen}}", "enteredAt": "{{datetime:-2 09:12}}" },
					{ "status": "{{lookup:status}}", "enteredAt": "{{datetime:-1 10:05}}" }
				]
			}
		},
		{
			"key": "vergunning-dakkapel",
			"register": "dossiq",
			"schema": "case",
			"lookups": {
				"caseType": { "schema": "caseType", "where": { "identifier": "omgevingsvergunning" } },
				"ontvangen": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "Ontvangen" } },
				"status": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "In behandeling" } }
			},
			"jsonFields": ["statusHistory"],
			"data": {
				"title": "Dakkapel Lindelaan 14",
				"description": "Ik wil een dakkapel plaatsen aan de achterkant van mijn huis.",
				"caseType": "{{lookup:caseType}}",
				"status": "{{lookup:status}}",
				"portalSubject": "{{subject}}",
				"intakeChannel": "website",
				"startDate": "{{date:-12}}",
				"receivedAt": "{{datetime:-12 14:30}}",
				"currentStatusEnteredAt": "{{datetime:-9 11:20}}",
				"waitingOnApplicant": true,
				"waitingOnApplicantSince": "{{datetime:-1 15:40}}",
				"statusHistory": [
					{ "status": "{{lookup:ontvangen}}", "enteredAt": "{{datetime:-12 14:30}}" },
					{ "status": "{{lookup:status}}", "enteredAt": "{{datetime:-9 11:20}}" }
				]
			}
		},
		{
			"key": "melding-stoeptegel",
			"register": "dossiq",
			"schema": "case",
			"lookups": {
				"caseType": { "schema": "caseType", "where": { "identifier": "melding-openbare-ruimte" } },
				"status": { "schema": "statusType", "where": { "caseType": "{{lookup:caseType}}", "name": "Ontvangen" } }
			},
			"jsonFields": ["statusHistory"],
			"data": {
				"title": "Losse stoeptegel bij de bushalte Lindelaan",
				"description": "Bij de bushalte ligt een stoeptegel los. Mensen struikelen erover.",
				"caseType": "{{lookup:caseType}}",
				"status": "{{lookup:status}}",
				"portalSubject": "{{subject}}",
				"intakeChannel": "website",
				"startDate": "{{date:-1}}",
				"receivedAt": "{{datetime:-1 08:15}}",
				"currentStatusEnteredAt": "{{datetime:-1 08:15}}",
				"statusHistory": [
					{ "status": "{{lookup:status}}", "enteredAt": "{{datetime:-1 08:15}}" }
				]
			}
		},
