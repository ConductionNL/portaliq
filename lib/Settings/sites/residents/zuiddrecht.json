			}
		},
		{
			"key": "bericht-dakkapel-vraag",
			"register": "dossiq",
			"schema": "portaalBericht",
			"data": {
				"caseId": "{{object:vergunning-dakkapel.id}}",
				"caseReference": "{{object:vergunning-dakkapel.identifier}}",
				"senderRef": "gemeente-zuiddrecht",
				"senderName": "Gemeente Zuiddrecht",
				"recipientRef": "{{subject}}",
				"direction": "handler_to_citizen",
				"subject": "Wij hebben nog een bouwtekening van u nodig",
