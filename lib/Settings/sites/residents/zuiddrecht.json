			}
		},
		{
			"key": "vraag-bouwtekening",
			"register": "dossiq",
			"schema": "aanvullingsverzoek",
			"data": {
				"case": "{{object:vergunning-dakkapel.id}}",
				"portalSubject": "{{subject}}",
				"summary": "Stuur de bouwtekening van uw dakkapel",
				"missingItems": [
					{ "item": "Bouwtekening van de dakkapel met maten", "received": false }
				],
				"requestedAt": "{{datetime:-1 15:40}}",
				"hersteltermijn": "{{date:13}}",
				"state": "open"
			}
		},
		{
			"key": "bericht-woo-ontvangen",
			"register": "dossiq",
			"schema": "portaalBericht",
			"data": {
				"caseId": "{{object:woo-fietspad.id}}",
				"caseReference": "{{object:woo-fietspad.identifier}}",
				"senderRef": "gemeente-zuiddrecht",
				"senderName": "Gemeente Zuiddrecht",
				"recipientRef": "{{subject}}",
