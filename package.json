{
  "name": "portaliq",
  "version": "0.1.0",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "build": "npm run build:admin && npm run build:portal",
    "build:admin": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "build:portal": "NODE_ENV=production webpack --config webpack.portal.js --progress",
    "watch:portal": "NODE_ENV=development webpack --config webpack.portal.js --progress --watch",
    "build:all": "npm run build",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "stylelint": "stylelint src/**/*.vue src/**/*.scss src/**/*.css",
    "stylelint-fix": "stylelint src/**/*.vue src/**/*.scss src/**/*.css --fix",
    "check:manifest": "node tests/validate-manifest.js",
    "check:manifest-v2": "node tests/manifest-v2.spec.js",
    "check:register": "node tests/validate-register.js",
    "check:registry": "node tests/registry.spec.js",
    "check:json-strict": "node tests/validate-json-strict.js",
    "check:specs": "npm run check:json-strict && npm run check:manifest-v2 && npm run check:register && npm run check:registry",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.27.1",
    "@babel/runtime": "^7.23.6",
    "@conduction/nextcloud-vue": "2.1.0-vue3.16",
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@utrecht/component-library-react": "^14.0.0",
    "@vueuse/core": "^14.3.0",
    "axe-core": "^4.10.0",
    "axios": "^1.7.9",
    "babel-loader": "^10.1.1",
    "dexie": "^4.0.8",
    "dompurify": "^3.4.12",
    "gridstack": "^12.6.0",
    "marked": "^12.0.0",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "pinia": "^2.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vue": "^3.5.13",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "libxmljs2": "^0.37.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/vue": "^9.9.0",
    "eslint-import-resolver-typescript": "~3.8.7",
    "eslint-plugin-import-x": {
      "@typescript-eslint/utils": "^7.18.0"
    }
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/config-helpers": "^0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/eslint-config-typescript": "^13.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "css-loader": "~7.1.1",
    "eslint": "^8.56.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "~3.8.7",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-vue": "^9.21.1",
    "path-browserify": "^1.0.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "~4.0.0",
    "stylelint": "^15.11.0",
    "terser-webpack-plugin": "^5.3.14",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  }
}
